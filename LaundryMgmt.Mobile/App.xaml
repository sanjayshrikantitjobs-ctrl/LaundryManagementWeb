<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:LaundryMgmt.Mobile.Converters"
             x:Class="LaundryMgmt.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:GarmentIconConverter x:Key="GarmentIconConverter" />
            <converters:ServiceIconConverter x:Key="ServiceIconConverter" />
            <converters:CustomerStatusColorConverter x:Key="CustomerStatusColorConverter" />
            <converters:CustomerStatusToggleLabelConverter x:Key="CustomerStatusToggleLabelConverter" />
            <converters:ActiveToggleLabelConverter x:Key="ActiveToggleLabelConverter" />
            <converters:ResolvedImageUrlConverter x:Key="ResolvedImageUrlConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
