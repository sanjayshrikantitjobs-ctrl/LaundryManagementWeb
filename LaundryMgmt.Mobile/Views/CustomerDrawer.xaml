<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="LaundryMgmt.Mobile.Views.CustomerDrawer"
             InputTransparent="False">

    <Grid x:Name="RootGrid" HorizontalOptions="Fill" VerticalOptions="Fill">

        <!-- Backdrop: dims the page behind the drawer; tapping it closes the drawer.
             Starts input-transparent (closed) so it never blocks the page underneath;
             code-behind flips this only while the drawer is actually open. -->
        <BoxView x:Name="Backdrop" Color="{StaticResource HeaderNavy}" Opacity="0" InputTransparent="True"
                 HorizontalOptions="Fill" VerticalOptions="Fill">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Sliding panel. No Shadow here deliberately — a Shadow on a Border that
             also has an animated TranslationX has a known MAUI/Android rendering bug
             where the content can fail to composite at all (shows the dimmed backdrop
             with nothing on top of it); a plain 1px edge stroke gives definition
             instead without that risk. -->
        <Border x:Name="Panel" HorizontalOptions="Start" VerticalOptions="Fill" WidthRequest="280"
                Stroke="{StaticResource Border}" StrokeThickness="1" BackgroundColor="{StaticResource Surface}" Padding="0">
            <Border.StrokeShape>
                <shapes:Rectangle />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Brand header -->
                <Border Grid.Row="0" StrokeShape="Rectangle" Stroke="Transparent" BackgroundColor="{StaticResource HeaderNavy}" Padding="18,24,16,18">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 12" Stroke="Transparent" WidthRequest="42" HeightRequest="42" Padding="0">
                            <Image Source="brand_mark.png" Aspect="AspectFit" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Shrios Laundry Wala" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource White}" LineBreakMode="TailTruncation" />
                            <Label x:Name="UserNameLabel" Text="Welcome back" FontSize="12" TextColor="{StaticResource NavyMuted}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" WidthRequest="30" HeightRequest="30" StrokeShape="RoundRectangle 15" Stroke="Transparent"
                                BackgroundColor="{StaticResource HeaderNavyLight}" VerticalOptions="Start">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackdropTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="&#x2715;" TextColor="{StaticResource White}" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Nav items -->
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Padding="10,14" Spacing="2">

                        <!-- Home: roof + walls, a literal house -->
                        <Border x:Name="ShopItem" StrokeShape="RoundRectangle 12" Stroke="Transparent" Padding="10,11">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnShopTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="46,*" ColumnSpacing="4">
                                <Border Style="{StaticResource IconBadge}">
                                    <Grid HeightRequest="18" WidthRequest="18">
                                        <shapes:Polygon Points="9,0 18,8 0,8" Fill="{StaticResource Primary}" VerticalOptions="Start" HeightRequest="8" />
                                        <shapes:Rectangle Fill="{StaticResource Primary}" WidthRequest="12" HeightRequest="10" VerticalOptions="End" />
                                        <shapes:Rectangle Fill="{StaticResource White}" WidthRequest="4" HeightRequest="6" VerticalOptions="End" HorizontalOptions="Center" />
                                    </Grid>
                                </Border>
                                <Label x:Name="ShopLabel" Grid.Column="1" Text="Home" FontSize="14.5" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Services: a washing machine — body, drum window, control strip -->
                        <Border x:Name="ServiceInfoItem" StrokeShape="RoundRectangle 12" Stroke="Transparent" Padding="10,11">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnServiceInfoTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="46,*" ColumnSpacing="4">
                                <Border Style="{StaticResource IconBadge}">
                                    <Grid HeightRequest="19" WidthRequest="18">
                                        <shapes:RoundRectangle Fill="{StaticResource Primary}" WidthRequest="18" HeightRequest="19" CornerRadius="3" />
                                        <shapes:Rectangle Fill="{StaticResource White}" WidthRequest="10" HeightRequest="2.5" VerticalOptions="Start" Margin="0,2.5,0,0" />
                                        <shapes:Ellipse Fill="{StaticResource White}" WidthRequest="10" HeightRequest="10" VerticalOptions="End" Margin="0,0,0,2" />
                                        <shapes:Ellipse Fill="{StaticResource Primary}" WidthRequest="5" HeightRequest="5" VerticalOptions="End" Margin="0,0,0,4.5" />
                                    </Grid>
                                </Border>
                                <Label x:Name="ServiceInfoLabel" Grid.Column="1" Text="Services" FontSize="14.5" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Promotions: a coupon/tag with a punch-hole -->
                        <Border x:Name="PromotionsItem" StrokeShape="RoundRectangle 12" Stroke="Transparent" Padding="10,11">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPromotionsTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="46,*" ColumnSpacing="4">
                                <Border Style="{StaticResource IconBadge}">
                                    <Grid HeightRequest="16" WidthRequest="19" Rotation="-45">
                                        <shapes:RoundRectangle Fill="{StaticResource Primary}" WidthRequest="19" HeightRequest="14" CornerRadius="2,6,6,2" />
                                        <shapes:Ellipse Fill="{StaticResource White}" WidthRequest="4" HeightRequest="4" HorizontalOptions="End" Margin="0,0,4,0" />
                                    </Grid>
                                </Border>
                                <Label x:Name="PromotionsLabel" Grid.Column="1" Text="Promotions" FontSize="14.5" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- My Requests -->
                        <Border x:Name="MyRequestsItem" StrokeShape="RoundRectangle 12" Stroke="Transparent" Padding="10,11">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMyRequestsTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="46,*" ColumnSpacing="4">
                                <Border Style="{StaticResource IconBadge}">
                                    <Grid>
                                        <shapes:RoundRectangle Fill="{StaticResource Primary}" WidthRequest="18" HeightRequest="18" CornerRadius="3" />
                                        <shapes:Rectangle Fill="{StaticResource White}" WidthRequest="11" HeightRequest="2" Margin="0,-4,0,0" />
                                        <shapes:Rectangle Fill="{StaticResource White}" WidthRequest="11" HeightRequest="2" />
                                        <shapes:Rectangle Fill="{StaticResource White}" WidthRequest="11" HeightRequest="2" Margin="0,4,0,0" />
                                    </Grid>
                                </Border>
                                <Label x:Name="MyRequestsLabel" Grid.Column="1" Text="My Requests" FontSize="14.5" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- My Orders: a shopping bag with a loop handle -->
                        <Border x:Name="OrdersItem" StrokeShape="RoundRectangle 12" Stroke="Transparent" Padding="10,11">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOrdersTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="46,*" ColumnSpacing="4">
                                <Border Style="{StaticResource IconBadge}">
                                    <Grid HeightRequest="19" WidthRequest="18">
                                        <shapes:Polygon Points="2,6 16,6 18,19 0,19" Fill="{StaticResource Primary}" VerticalOptions="End" HeightRequest="13" />
                                        <shapes:RoundRectangle Stroke="{StaticResource Primary}" StrokeThickness="2.2" Fill="Transparent"
                                                                CornerRadius="6" WidthRequest="10" HeightRequest="11" VerticalOptions="Start" />
                                    </Grid>
                                </Border>
                                <Label x:Name="OrdersLabel" Grid.Column="1" Text="My Orders" FontSize="14.5" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Price List: a coin/rupee badge -->
                        <Border x:Name="PriceListItem" StrokeShape="RoundRectangle 12" Stroke="Transparent" Padding="10,11">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPriceListTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="46,*" ColumnSpacing="4">
                                <Border Style="{StaticResource IconBadge}">
                                    <Grid HeightRequest="20" WidthRequest="20">
                                        <shapes:Ellipse Fill="{StaticResource Primary}" WidthRequest="20" HeightRequest="20" />
                                        <Label Text="₹" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="13"
                                               HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-1,0,0" />
                                    </Grid>
                                </Border>
                                <Label x:Name="PriceListLabel" Grid.Column="1" Text="Price List" FontSize="14.5" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Membership -->
                        <Border x:Name="MembershipItem" StrokeShape="RoundRectangle 12" Stroke="Transparent" Padding="10,11">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMembershipTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="46,*" ColumnSpacing="4">
                                <Border Style="{StaticResource IconBadge}">
                                    <Grid>
                                        <shapes:RoundRectangle Fill="{StaticResource Primary}" WidthRequest="20" HeightRequest="15" CornerRadius="3" />
                                        <shapes:Rectangle Fill="{StaticResource White}" WidthRequest="20" HeightRequest="3.5" VerticalOptions="Start" Margin="0,4,0,0" />
                                    </Grid>
                                </Border>
                                <Label x:Name="MembershipLabel" Grid.Column="1" Text="Membership" FontSize="14.5" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Settings: a gear — ring plus four teeth -->
                        <Border x:Name="SettingsItem" StrokeShape="RoundRectangle 12" Stroke="Transparent" Padding="10,11">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSettingsTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="46,*" ColumnSpacing="4">
                                <Border Style="{StaticResource IconBadge}">
                                    <Grid HeightRequest="20" WidthRequest="20">
                                        <shapes:Rectangle Fill="{StaticResource Primary}" WidthRequest="4" HeightRequest="20" HorizontalOptions="Center" />
                                        <shapes:Rectangle Fill="{StaticResource Primary}" WidthRequest="20" HeightRequest="4" VerticalOptions="Center" />
                                        <shapes:Rectangle Fill="{StaticResource Primary}" WidthRequest="4" HeightRequest="20" HorizontalOptions="Center" Rotation="45" />
                                        <shapes:Rectangle Fill="{StaticResource Primary}" WidthRequest="4" HeightRequest="20" HorizontalOptions="Center" Rotation="-45" />
                                        <shapes:Ellipse Fill="{StaticResource Primary}" WidthRequest="16" HeightRequest="16" />
                                        <shapes:Ellipse Fill="{StaticResource White}" WidthRequest="7" HeightRequest="7" />
                                    </Grid>
                                </Border>
                                <Label x:Name="SettingsLabel" Grid.Column="1" Text="Settings" FontSize="14.5" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Contact Us: an envelope -->
                        <Border x:Name="ContactUsItem" StrokeShape="RoundRectangle 12" Stroke="Transparent" Padding="10,11">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnContactUsTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="46,*" ColumnSpacing="4">
                                <Border Style="{StaticResource IconBadge}">
                                    <Grid HeightRequest="15" WidthRequest="20">
                                        <shapes:RoundRectangle Fill="{StaticResource Primary}" WidthRequest="20" HeightRequest="15" CornerRadius="2" />
                                        <shapes:Polygon Points="0,0 10,8 20,0" Fill="{StaticResource White}" WidthRequest="20" HeightRequest="8" VerticalOptions="Start" />
                                    </Grid>
                                </Border>
                                <Label x:Name="ContactUsLabel" Grid.Column="1" Text="Contact Us" FontSize="14.5" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- Footer -->
                <VerticalStackLayout Grid.Row="2" Spacing="0">
                    <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                    <Label Text="Shrios Laundry Wala · v1.0" FontSize="11" TextColor="{StaticResource Gray600}"
                           HorizontalOptions="Center" Padding="0,10,0,14" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentView>
