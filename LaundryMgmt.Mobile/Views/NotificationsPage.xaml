<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             xmlns:models="clr-namespace:LaundryMgmt.Mobile.Models"
             x:Class="LaundryMgmt.Mobile.Views.NotificationsPage"
             Shell.TabBarIsVisible="False"
             x:DataType="vm:NotificationsViewModel"
             Title="Notifications">

    <Grid RowDefinitions="Auto,Auto,*">
        <Label Grid.Row="0" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
               Padding="16,8" BackgroundColor="{StaticResource DangerLight}" />

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                            Color="{StaticResource Primary}" VerticalOptions="Center" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Notifications}"
                         IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                    <Label Text="🔔" FontSize="40" HorizontalTextAlignment="Center" />
                    <Label Text="You're all caught up." HorizontalTextAlignment="Center" Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:NotificationDto">
                    <Frame Style="{StaticResource ListCard}">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                CommandParameter="{Binding .}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCommand}" />
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <BoxView Grid.Column="0" WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Start" Margin="0,6,0,0"
                                     Color="{StaticResource Accent}" IsVisible="{Binding IsRead, Converter={StaticResource InvertedBoolConverter}}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" />
                                <Label Text="{Binding Message}" Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding CreatedAtUtc, StringFormat='{0:d MMM, h:mm tt}'}" FontSize="11" Style="{StaticResource SubtleLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
