<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             xmlns:behaviors="clr-namespace:LaundryMgmt.Mobile.Behaviors"
             x:Class="LaundryMgmt.Mobile.Views.ServiceFormPage"
             x:DataType="vm:ServiceFormViewModel"
             Title="New Service">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Frame>
                <VerticalStackLayout Spacing="8">
                    <Label Text="NAME" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding Name}" Placeholder="Washing, Dry Cleaning, Iron Only…" />

                    <Label Text="CATEGORY" Style="{StaticResource SectionLabel}" />
                    <Picker ItemsSource="{Binding Categories}" ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedCategory}" Title="Select a category" />

                    <Label Text="BASE PRICE" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding BasePriceText}" Keyboard="Numeric" />

                    <Label Text="ESTIMATED TIME (HOURS)" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding EstimatedTimeHoursText}" Keyboard="Numeric" />

                    <Label Text="GST %" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding GstPercentageText}" Keyboard="Numeric" />

                    <Label Text="PRIORITY" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding PriorityText}" Keyboard="Numeric" />

                    <Label Text="EXPRESS SURCHARGE (₹)" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding ExpressSurchargeText}" Keyboard="Numeric" />

                    <Label Text="EXPRESS ETA (HOURS)" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding ExpressEtaHoursText}" Keyboard="Numeric" />

                    <Label Text="IMAGE" Style="{StaticResource SectionLabel}" />
                    <Border StrokeShape="RoundRectangle 12" Stroke="Transparent" BackgroundColor="{StaticResource Gray50}"
                            HeightRequest="120" Padding="0"
                            IsVisible="{Binding ImageUrl, Converter={StaticResource IsNotNullConverter}}">
                        <Image behaviors:TrustedImage.Url="{Binding ImageUrl, Converter={StaticResource ResolvedImageUrlConverter}}"
                               Aspect="AspectFill" />
                    </Border>
                    <Button Text="Choose Image" Command="{Binding PickImageCommand}"
                            IsEnabled="{Binding IsUploadingImage, Converter={StaticResource InvertedBoolConverter}}" />
                    <ActivityIndicator IsRunning="{Binding IsUploadingImage}" IsVisible="{Binding IsUploadingImage}" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />

            <Button Text="Save" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
