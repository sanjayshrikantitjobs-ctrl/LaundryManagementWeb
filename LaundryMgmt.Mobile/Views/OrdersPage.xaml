<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             xmlns:models="clr-namespace:LaundryMgmt.Mobile.Models"
             xmlns:views="clr-namespace:LaundryMgmt.Mobile.Views"
             x:Class="LaundryMgmt.Mobile.Views.OrdersPage"
             x:DataType="vm:OrdersViewModel"
             Title="Orders">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <views:ModuleBreadcrumb x:Name="ManagementNavBar" Grid.Row="0" CurrentModule="orders" />
        <views:CustomerNavBar x:Name="CustomerNav" Grid.Row="0" CurrentPage="orders" IsVisible="False" />

        <ScrollView Grid.Row="1" Orientation="Horizontal" Padding="12,8">
            <HorizontalStackLayout Spacing="8">
                <Button Text="All" CommandParameter="{x:Static vm:OrderTab.All}" Command="{Binding SetTabCommand}" />
                <Button Text="New" CommandParameter="{x:Static vm:OrderTab.New}" Command="{Binding SetTabCommand}" />
                <Button Text="In Progress" CommandParameter="{x:Static vm:OrderTab.InProgress}" Command="{Binding SetTabCommand}" />
                <Button Text="Completed" CommandParameter="{x:Static vm:OrderTab.Completed}" Command="{Binding SetTabCommand}" />
                <Button Text="Cancelled" CommandParameter="{x:Static vm:OrderTab.Cancelled}" Command="{Binding SetTabCommand}" />
            </HorizontalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Text="+ New Order" HorizontalOptions="End" Margin="16,0,16,8"
                Command="{Binding NewOrderCommand}" />

        <Label Grid.Row="3" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
               Padding="16,8" BackgroundColor="{StaticResource DangerLight}" />

        <RefreshView Grid.Row="4" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Orders}"
                            RemainingItemsThreshold="3"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                        <Label Text="📦" FontSize="40" HorizontalTextAlignment="Center" />
                        <Label Text="No orders yet." HorizontalTextAlignment="Center" Style="{StaticResource SubtleLabel}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:OrderListItem">
                        <Frame Style="{StaticResource ListCard}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    CommandParameter="{Binding .}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenOrderCommand}" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding OrderNumber}" FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Badge}" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding CustomerName}" Style="{StaticResource SubtleLabel}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding TotalAmount, StringFormat='₹{0:0.00}'}" FontAttributes="Bold" />
                                <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource SubtleLabel}"
                                       Text="{Binding PromisedByUtc, StringFormat='Expected delivery: {0:d MMM, h:mm tt}'}"
                                       IsVisible="{Binding PromisedByUtc, Converter={StaticResource IsNotNullConverter}}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
