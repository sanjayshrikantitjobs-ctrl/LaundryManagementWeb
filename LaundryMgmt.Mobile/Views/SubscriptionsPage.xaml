<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             xmlns:models="clr-namespace:LaundryMgmt.Mobile.Models"
             xmlns:views="clr-namespace:LaundryMgmt.Mobile.Views"
             x:Class="LaundryMgmt.Mobile.Views.SubscriptionsPage"
             Shell.TabBarIsVisible="False"
             x:DataType="vm:SubscriptionsViewModel"
             Title="Subscriptions">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <views:ModuleBreadcrumb x:Name="ManagementNavBar" Grid.Row="0" CurrentModule="subscriptions" />
        <views:CustomerNavBar x:Name="CustomerNav" Grid.Row="0" CurrentPage="membership" IsVisible="False" />

        <Button Grid.Row="1" Text="+ New Plan" HorizontalOptions="End" Margin="16,8"
                Command="{Binding NewPlanCommand}" IsVisible="{Binding CanEditMasterData}" />

        <Label Grid.Row="2" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
               Padding="16,8" BackgroundColor="{StaticResource DangerLight}" />

        <ActivityIndicator Grid.Row="3" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                            Color="{StaticResource Primary}" VerticalOptions="Center" />

        <CollectionView Grid.Row="4" ItemsSource="{Binding Plans}"
                         IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                    <Label Text="🏷️" FontSize="40" HorizontalTextAlignment="Center" />
                    <Label Text="No subscription plans yet." HorizontalTextAlignment="Center" Style="{StaticResource SubtleLabel}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SubscriptionPlanDto">
                    <Frame Style="{StaticResource ListCard}">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                CommandParameter="{Binding .}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenPlanCommand}" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                <Label Grid.Column="1" Text="{Binding Price, StringFormat='₹{0:0.00}'}"
                                       TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                            </Grid>
                            <Label Text="{Binding GarmentsPerCycle, StringFormat='{0} garments/cycle'}" Style="{StaticResource SubtleLabel}" />
                            <Label Text="{Binding Description}" Style="{StaticResource SubtleLabel}"
                                   IsVisible="{Binding Description, Converter={StaticResource IsNotNullConverter}}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Features}" Spacing="2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:SubscriptionPlanFeatureDto">
                                        <Label Text="{Binding Text, StringFormat='✓ {0}'}" FontSize="13" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Label Text="✏️ Tap to edit" FontSize="11" Style="{StaticResource SubtleLabel}" HorizontalOptions="End"
                                   IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanEditMasterData}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
