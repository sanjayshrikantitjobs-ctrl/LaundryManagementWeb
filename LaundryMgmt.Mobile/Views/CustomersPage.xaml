<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             xmlns:models="clr-namespace:LaundryMgmt.Mobile.Models"
             xmlns:views="clr-namespace:LaundryMgmt.Mobile.Views"
             x:Class="LaundryMgmt.Mobile.Views.CustomersPage"
             x:DataType="vm:CustomersViewModel"
             Title="Customers">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ New" Command="{Binding NewCustomerCommand}" IsEnabled="{Binding CanEditMasterData}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <views:ModuleBreadcrumb Grid.Row="0" CurrentModule="customers" />

        <SearchBar Grid.Row="1"
                   Placeholder="Search by name, phone or email…"
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding RefreshCommand}" />

        <ScrollView Grid.Row="2" Orientation="Horizontal" Padding="12,0,12,8">
            <HorizontalStackLayout Spacing="8">
                <Button Text="All" CommandParameter="{x:Static vm:CustomerTab.All}" Command="{Binding SetTabCommand}" />
                <Button Text="Active" CommandParameter="{x:Static vm:CustomerTab.Active}" Command="{Binding SetTabCommand}" />
                <Button Text="Inactive" CommandParameter="{x:Static vm:CustomerTab.Inactive}" Command="{Binding SetTabCommand}" />
            </HorizontalStackLayout>
        </ScrollView>

        <Label Grid.Row="3" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
               Padding="16,8" BackgroundColor="{StaticResource DangerLight}" />

        <RefreshView Grid.Row="4" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Customers}"
                            RemainingItemsThreshold="3"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                        <Label Text="👤" FontSize="40" HorizontalTextAlignment="Center" />
                        <Label Text="No customers found." HorizontalTextAlignment="Center" Style="{StaticResource SubtleLabel}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CustomerListItem">
                        <Frame Style="{StaticResource ListCard}">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                                <VerticalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="0">
                                    <Label Text="{Binding FullName}" FontAttributes="Bold" />
                                    <Label Text="{Binding PhoneNumber}" Style="{StaticResource SubtleLabel}" />
                                    <Label Text="{Binding Status}" TextColor="{Binding Status, Converter={StaticResource CustomerStatusColorConverter}}"
                                           FontAttributes="Bold" FontSize="12" />
                                </VerticalStackLayout>
                                <Button Grid.Row="0" Grid.Column="1" Text="Edit"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanEditMasterData}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCustomerCommand}" />
                                <Button Grid.Row="0" Grid.Column="2" Text="{Binding Status, Converter={StaticResource CustomerStatusToggleLabelConverter}}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanEditMasterData}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleStatusCommand}" />
                                <Button Grid.Row="0" Grid.Column="3" Text="Delete" Style="{StaticResource DangerButton}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanEditMasterData}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCustomerCommand}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
