<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             xmlns:models="clr-namespace:LaundryMgmt.Mobile.Models"
             xmlns:views="clr-namespace:LaundryMgmt.Mobile.Views"
             x:Class="LaundryMgmt.Mobile.Views.CustomersPage"
             x:DataType="vm:CustomersViewModel"
             Title="Customers">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <views:ModuleBreadcrumb Grid.Row="0" CurrentModule="customers" />

        <SearchBar Grid.Row="1"
                   Placeholder="Search by name, phone or email…"
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding RefreshCommand}" />

        <ScrollView Grid.Row="2" Orientation="Horizontal" Padding="12,0,12,8">
            <HorizontalStackLayout Spacing="8">
                <Button Text="All" CommandParameter="{x:Static vm:CustomerTab.All}" Command="{Binding SetTabCommand}" />
                <Button Text="Active" CommandParameter="{x:Static vm:CustomerTab.Active}" Command="{Binding SetTabCommand}" />
                <Button Text="Inactive" CommandParameter="{x:Static vm:CustomerTab.Inactive}" Command="{Binding SetTabCommand}" />
                <Button Text="Subscribed" CommandParameter="{x:Static vm:CustomerTab.Subscribed}" Command="{Binding SetTabCommand}" />
            </HorizontalStackLayout>
        </ScrollView>

        <Button Grid.Row="3" Text="+ New Customer" HorizontalOptions="End" Margin="16,0,16,8"
                Command="{Binding NewCustomerCommand}" IsVisible="{Binding CanEditMasterData}" />

        <Label Grid.Row="4" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
               Padding="16,8" BackgroundColor="{StaticResource DangerLight}" />

        <RefreshView Grid.Row="5" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}"
                     IsVisible="{Binding IsSubscribedTab, Converter={StaticResource InvertedBoolConverter}}">
            <CollectionView ItemsSource="{Binding Customers}"
                            RemainingItemsThreshold="3"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                        <Label Text="👤" FontSize="40" HorizontalTextAlignment="Center" />
                        <Label Text="No customers found." HorizontalTextAlignment="Center" Style="{StaticResource SubtleLabel}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CustomerListItem">
                        <Frame Style="{StaticResource ListCard}" Padding="16,14" MinimumHeightRequest="76">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    CommandParameter="{Binding .}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCustomerCommand}" />
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding FullName}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                <Label Text="{Binding PhoneNumber}" Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding Status}" TextColor="{Binding Status, Converter={StaticResource CustomerStatusColorConverter}}"
                                       FontAttributes="Bold" FontSize="12" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Grid Grid.Row="5" IsVisible="{Binding IsSubscribedTab}">
            <ActivityIndicator IsRunning="{Binding IsLoadingSubscribed}" IsVisible="{Binding IsLoadingSubscribed}"
                                Color="{StaticResource Primary}" VerticalOptions="Center" />
            <CollectionView ItemsSource="{Binding SubscribedCustomers}"
                            IsVisible="{Binding IsLoadingSubscribed, Converter={StaticResource InvertedBoolConverter}}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                        <Label Text="🎫" FontSize="40" HorizontalTextAlignment="Center" />
                        <Label Text="No subscribed customers found." HorizontalTextAlignment="Center" Style="{StaticResource SubtleLabel}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CustomerSubscriptionListItemDto">
                        <Frame Style="{StaticResource ListCard}">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding CustomerName}" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Badge}" />
                                </Grid>
                                <Label Text="{Binding PlanName}" Style="{StaticResource SubtleLabel}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding EndDate, StringFormat='Valid until {0:d MMM y}'}" FontSize="12" />
                                    <Label Grid.Column="1" Text="{Binding RecurringValue, StringFormat='₹{0:0.00}'}" FontAttributes="Bold" />
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>

</ContentPage>
