<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             xmlns:models="clr-namespace:LaundryMgmt.Mobile.Models"
             xmlns:views="clr-namespace:LaundryMgmt.Mobile.Views"
             x:Class="LaundryMgmt.Mobile.Views.CustomersPage"
             Shell.TabBarIsVisible="False"
             x:DataType="vm:CustomersViewModel"
             Title="Customers">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <SearchBar Grid.Row="0"
                   Placeholder="Search by name, phone or email…"
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding RefreshCommand}" />

        <!-- Status filter: same compact, horizontally-scrollable segmented chip strip
             as OrdersPage — live counts, subtle press animation, unchanged
             SetTabCommand/ActiveTab underneath. -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" Padding="12,4,12,8" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8">
                <Border StrokeShape="RoundRectangle 10" Stroke="{StaticResource Border}" StrokeThickness="1"
                        BackgroundColor="{StaticResource Surface}" Padding="14,9" MinimumHeightRequest="42">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer CommandParameter="{x:Static vm:CustomerTab.All}" Command="{Binding SetTabCommand}" Tapped="OnStatusChipTapped" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding ActiveTab}" Value="{x:Static vm:CustomerTab.All}">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}" />
                            <Setter Property="Stroke" Value="Transparent" />
                            <Setter TargetName="AllLabel" Property="Label.TextColor" Value="{StaticResource Primary}" />
                            <Setter TargetName="AllLabel" Property="Label.FontAttributes" Value="Bold" />
                            <Setter TargetName="AllBadge" Property="Border.BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter TargetName="AllCountLabel" Property="Label.TextColor" Value="{StaticResource White}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label x:Name="AllLabel" Text="All" FontSize="13.5" TextColor="{StaticResource Gray600}"
                               VerticalOptions="Center" LineBreakMode="NoWrap" />
                        <Border x:Name="AllBadge" StrokeShape="RoundRectangle 8" Stroke="Transparent" BackgroundColor="{StaticResource Gray50}"
                                Padding="6,2" MinimumWidthRequest="22" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label x:Name="AllCountLabel" Text="{Binding AllCount}" FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource Gray600}" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
                        </Border>
                    </HorizontalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 10" Stroke="{StaticResource Border}" StrokeThickness="1"
                        BackgroundColor="{StaticResource Surface}" Padding="14,9" MinimumHeightRequest="42">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer CommandParameter="{x:Static vm:CustomerTab.Active}" Command="{Binding SetTabCommand}" Tapped="OnStatusChipTapped" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding ActiveTab}" Value="{x:Static vm:CustomerTab.Active}">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}" />
                            <Setter Property="Stroke" Value="Transparent" />
                            <Setter TargetName="ActiveLabel" Property="Label.TextColor" Value="{StaticResource Primary}" />
                            <Setter TargetName="ActiveLabel" Property="Label.FontAttributes" Value="Bold" />
                            <Setter TargetName="ActiveBadge" Property="Border.BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter TargetName="ActiveCountLabel" Property="Label.TextColor" Value="{StaticResource White}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label x:Name="ActiveLabel" Text="Active" FontSize="13.5" TextColor="{StaticResource Gray600}"
                               VerticalOptions="Center" LineBreakMode="NoWrap" />
                        <Border x:Name="ActiveBadge" StrokeShape="RoundRectangle 8" Stroke="Transparent" BackgroundColor="{StaticResource Gray50}"
                                Padding="6,2" MinimumWidthRequest="22" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label x:Name="ActiveCountLabel" Text="{Binding ActiveCount}" FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource Gray600}" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
                        </Border>
                    </HorizontalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 10" Stroke="{StaticResource Border}" StrokeThickness="1"
                        BackgroundColor="{StaticResource Surface}" Padding="14,9" MinimumHeightRequest="42">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer CommandParameter="{x:Static vm:CustomerTab.Inactive}" Command="{Binding SetTabCommand}" Tapped="OnStatusChipTapped" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding ActiveTab}" Value="{x:Static vm:CustomerTab.Inactive}">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}" />
                            <Setter Property="Stroke" Value="Transparent" />
                            <Setter TargetName="InactiveLabel" Property="Label.TextColor" Value="{StaticResource Primary}" />
                            <Setter TargetName="InactiveLabel" Property="Label.FontAttributes" Value="Bold" />
                            <Setter TargetName="InactiveBadge" Property="Border.BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter TargetName="InactiveCountLabel" Property="Label.TextColor" Value="{StaticResource White}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label x:Name="InactiveLabel" Text="Inactive" FontSize="13.5" TextColor="{StaticResource Gray600}"
                               VerticalOptions="Center" LineBreakMode="NoWrap" />
                        <Border x:Name="InactiveBadge" StrokeShape="RoundRectangle 8" Stroke="Transparent" BackgroundColor="{StaticResource Gray50}"
                                Padding="6,2" MinimumWidthRequest="22" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label x:Name="InactiveCountLabel" Text="{Binding InactiveCount}" FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource Gray600}" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
                        </Border>
                    </HorizontalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 10" Stroke="{StaticResource Border}" StrokeThickness="1"
                        BackgroundColor="{StaticResource Surface}" Padding="14,9" MinimumHeightRequest="42">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer CommandParameter="{x:Static vm:CustomerTab.Subscribed}" Command="{Binding SetTabCommand}" Tapped="OnStatusChipTapped" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding ActiveTab}" Value="{x:Static vm:CustomerTab.Subscribed}">
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}" />
                            <Setter Property="Stroke" Value="Transparent" />
                            <Setter TargetName="SubscribedLabel" Property="Label.TextColor" Value="{StaticResource Primary}" />
                            <Setter TargetName="SubscribedLabel" Property="Label.FontAttributes" Value="Bold" />
                            <Setter TargetName="SubscribedBadge" Property="Border.BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter TargetName="SubscribedCountLabel" Property="Label.TextColor" Value="{StaticResource White}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label x:Name="SubscribedLabel" Text="Subscribed" FontSize="13.5" TextColor="{StaticResource Gray600}"
                               VerticalOptions="Center" LineBreakMode="NoWrap" />
                        <Border x:Name="SubscribedBadge" StrokeShape="RoundRectangle 8" Stroke="Transparent" BackgroundColor="{StaticResource Gray50}"
                                Padding="6,2" MinimumWidthRequest="22" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label x:Name="SubscribedCountLabel" Text="{Binding SubscribedCount}" FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource Gray600}" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
                        </Border>
                    </HorizontalStackLayout>
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Text="+ New Customer" HorizontalOptions="End" Margin="16,0,16,8"
                Command="{Binding NewCustomerCommand}" IsVisible="{Binding CanEditMasterData}" />

        <Label Grid.Row="3" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
               Padding="16,8" BackgroundColor="{StaticResource DangerLight}" />

        <RefreshView Grid.Row="4" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}"
                     IsVisible="{Binding IsSubscribedTab, Converter={StaticResource InvertedBoolConverter}}">
            <CollectionView ItemsSource="{Binding Customers}"
                            RemainingItemsThreshold="3"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                        <Label Text="👤" FontSize="40" HorizontalTextAlignment="Center" />
                        <Label Text="No customers found." HorizontalTextAlignment="Center" Style="{StaticResource SubtleLabel}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CustomerListItem">
                        <Frame Style="{StaticResource ListCard}" Padding="16,14" MinimumHeightRequest="76">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    CommandParameter="{Binding .}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCustomerCommand}" />
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding FullName}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                <Label Text="{Binding PhoneNumber}" Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding Status}" TextColor="{Binding Status, Converter={StaticResource CustomerStatusColorConverter}}"
                                       FontAttributes="Bold" FontSize="12" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Grid Grid.Row="4" IsVisible="{Binding IsSubscribedTab}">
            <ActivityIndicator IsRunning="{Binding IsLoadingSubscribed}" IsVisible="{Binding IsLoadingSubscribed}"
                                Color="{StaticResource Primary}" VerticalOptions="Center" />
            <CollectionView ItemsSource="{Binding SubscribedCustomers}"
                            IsVisible="{Binding IsLoadingSubscribed, Converter={StaticResource InvertedBoolConverter}}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                        <Label Text="🎫" FontSize="40" HorizontalTextAlignment="Center" />
                        <Label Text="No subscribed customers found." HorizontalTextAlignment="Center" Style="{StaticResource SubtleLabel}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CustomerSubscriptionListItemDto">
                        <Frame Style="{StaticResource ListCard}">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding CustomerName}" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Badge}" />
                                </Grid>
                                <Label Text="{Binding PlanName}" Style="{StaticResource SubtleLabel}" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding EndDate, StringFormat='Valid until {0:d MMM y}'}" FontSize="12" />
                                    <Label Grid.Column="1" Text="{Binding RecurringValue, StringFormat='₹{0:0.00}'}" FontAttributes="Bold" />
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        </Grid>

        <views:AdminDrawer CurrentPage="customers" />
    </Grid>

</ContentPage>
