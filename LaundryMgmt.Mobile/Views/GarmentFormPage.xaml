<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             x:Class="LaundryMgmt.Mobile.Views.GarmentFormPage"
             x:DataType="vm:GarmentFormViewModel"
             Title="New Garment">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Frame>
                <VerticalStackLayout Spacing="8">
                    <Label Text="NAME" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding Name}" Placeholder="Shirt, Saree, Blanket…" />

                    <Label Text="CATEGORY" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding Category}" Placeholder="Menswear, Womenswear, Home…" />

                    <Label Text="BARCODE" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding Barcode}" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />

            <Button Text="Save" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
