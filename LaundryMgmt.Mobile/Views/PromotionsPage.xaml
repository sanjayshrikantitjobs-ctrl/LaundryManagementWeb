<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             xmlns:views="clr-namespace:LaundryMgmt.Mobile.Views"
             xmlns:behaviors="clr-namespace:LaundryMgmt.Mobile.Behaviors"
             x:Class="LaundryMgmt.Mobile.Views.PromotionsPage"
             Shell.TabBarIsVisible="False"
             x:DataType="vm:PromotionsViewModel"
             Title="Promotions">

    <Grid>
        <Grid RowDefinitions="Auto,*">
            <Label Grid.Row="0" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                   Padding="16,8" BackgroundColor="{StaticResource DangerLight}" />

            <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                Color="{StaticResource Primary}" VerticalOptions="Center" />

            <CollectionView Grid.Row="1" ItemsSource="{Binding Promotions}" Margin="0,8,0,0"
                             IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                        <Label Text="No active promotions right now." FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Gray600}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PromotionRow">
                        <Frame Style="{StaticResource ListCard}" Padding="0">
                            <VerticalStackLayout Spacing="0">
                                <Image behaviors:TrustedImage.Url="{Binding Promotion.ImageUrl, Converter={StaticResource ResolvedImageUrlConverter}}"
                                       IsVisible="{Binding Promotion.ImageUrl, Converter={StaticResource IsNotNullConverter}}"
                                       HeightRequest="130" Aspect="AspectFill" />

                                <VerticalStackLayout Spacing="6" Padding="16,14">
                                    <Label Text="{Binding Promotion.Title}" FontAttributes="Bold" FontSize="16.5" TextColor="{StaticResource HeaderNavy}" />
                                    <Label Text="{Binding Promotion.Description}" Style="{StaticResource SubtleLabel}"
                                           IsVisible="{Binding Promotion.Description, Converter={StaticResource IsNotNullConverter}}" />
                                    <Label Text="{Binding Promotion.ValidTo, StringFormat='Valid till {0:d MMM yyyy}'}"
                                           Style="{StaticResource SubtleLabel}" FontSize="12"
                                           IsVisible="{Binding Promotion.ValidTo, Converter={StaticResource IsNotNullConverter}}" />

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0" IsVisible="{Binding Promotion.Code, Converter={StaticResource IsNotNullConverter}}">
                                        <Border Grid.Column="0" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Primary}" StrokeThickness="1.3"
                                                BackgroundColor="{StaticResource PrimaryLight}" Padding="10,5" HorizontalOptions="Start">
                                            <Label Text="{Binding Promotion.Code}" FontAttributes="Bold" FontSize="13"
                                                   TextColor="{StaticResource PrimaryDark}" />
                                        </Border>
                                        <Button Grid.Column="1" Text="{Binding ButtonLabel}" FontSize="12" Padding="12,6"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.UseCodeCommand}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <views:CustomerDrawer CurrentPage="promotions" />
    </Grid>

</ContentPage>
