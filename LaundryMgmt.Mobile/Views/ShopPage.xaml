<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             xmlns:models="clr-namespace:LaundryMgmt.Mobile.Models"
             xmlns:views="clr-namespace:LaundryMgmt.Mobile.Views"
             xmlns:behaviors="clr-namespace:LaundryMgmt.Mobile.Behaviors"
             x:Class="LaundryMgmt.Mobile.Views.ShopPage"
             Shell.TabBarIsVisible="False"
             x:DataType="vm:ShopViewModel"
             Title="Shop">

    <Grid>
        <!-- No outer ScrollView: the hero and section label size to content (Auto), and
             the categories grid takes the entire remaining screen height (the "*" row)
             and is vertically centered within it — that's what previously left a big
             dead strip of white space below a fixed-height category box, and forced the
             grid into its own tiny nested scroll region instead of just fitting. -->
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

            <!-- Hero: a real photo carousel (bundled marketing banners). AspectFit
                 (never AspectFill) so the banner is always shown in full — the
                 source images aren't the same aspect ratio as the device width, and
                 AspectFill was cropping the headline text off the top/bottom. The
                 surrounding Surface fill means any left/right letterboxing blends
                 into the images' own light background instead of showing bars. -->
            <VerticalStackLayout Grid.Row="0" Spacing="6" Margin="14,10,14,0">
                <Border StrokeShape="RoundRectangle 14" Stroke="Transparent" BackgroundColor="{StaticResource Surface}" Padding="0">
                    <CarouselView x:Name="HeroCarousel" ItemsSource="{Binding HeroSlides}" HeightRequest="190"
                                  Loop="True" IndicatorView="{x:Reference HeroIndicator}">
                        <CarouselView.ItemTemplate>
                            <DataTemplate x:DataType="vm:HeroSlide">
                                <Image Source="{Binding ImageSource}" Aspect="AspectFit" />
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>
                </Border>
                <IndicatorView x:Name="HeroIndicator" HorizontalOptions="Center" HeightRequest="6"
                               IndicatorColor="{StaticResource Border}" SelectedIndicatorColor="{StaticResource Primary}" />
            </VerticalStackLayout>

            <Label Grid.Row="1" Text="What do you need cleaned?" Style="{StaticResource SectionLabel}" Margin="16,16,16,4" />

            <!-- Categories: a wrapping grid, sized to fill the rest of the screen and
                 centered within it. Tapping one navigates straight to GarmentListPage,
                 which opens on "All" services for that category. -->
            <CollectionView Grid.Row="2" ItemsSource="{Binding Categories}" SelectionMode="Single"
                             SelectedItem="{Binding SelectedCategory}" Margin="6,0,6,16" VerticalOptions="Center">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="4" VerticalItemSpacing="22" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ServiceCategoryDto">
                        <Border StrokeShape="RoundRectangle 18" Stroke="Transparent" BackgroundColor="Transparent" Padding="4,10">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}" />
                                            <Setter TargetName="CategoryLabel" Property="Label.TextColor" Value="{StaticResource PrimaryDark}" />
                                            <Setter TargetName="CategoryLabel" Property="Label.FontAttributes" Value="Bold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Border WidthRequest="84" HeightRequest="84" StrokeShape="RoundRectangle 42" Stroke="Transparent"
                                        BackgroundColor="{StaticResource PrimaryLight}" Padding="0" HorizontalOptions="Center">
                                    <Grid>
                                        <Image behaviors:TrustedImage.Url="{Binding IconOrImageUrl, Converter={StaticResource ResolvedImageUrlConverter}}"
                                               IsVisible="{Binding IconOrImageUrl, Converter={StaticResource IsNotNullConverter}}" Aspect="AspectFill" />
                                        <Label Text="{Binding Name, Converter={StaticResource CategoryIconConverter}}" FontSize="30"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               IsVisible="{Binding IconOrImageUrl, Converter={StaticResource IsNullOrEmptyConverter}}" />
                                    </Grid>
                                </Border>
                                <Label x:Name="CategoryLabel" Text="{Binding Name}" FontSize="14" TextColor="{StaticResource Gray900}"
                                       HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="2" WidthRequest="106" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout Grid.Row="2" VerticalOptions="Center">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                       Padding="16,8" BackgroundColor="{StaticResource DangerLight}" />

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                    Color="{StaticResource Primary}" Margin="0,20" />
            </VerticalStackLayout>
        </Grid>

        <!-- Full-screen "loading garments" overlay for the gap between tapping a
             category and GarmentListPage actually appearing — big and impossible to
             miss (a thin top-of-screen progress bar wasn't prominent enough). Driven
             by ShopViewModel.IsNavigatingToGarments; navigation itself is unchanged. -->
        <Grid IsVisible="{Binding IsNavigatingToGarments}" BackgroundColor="{StaticResource Overlay}"
              InputTransparent="False">
            <Border BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 16" Stroke="Transparent"
                    Padding="30,26" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsNavigatingToGarments}" Color="{StaticResource Primary}"
                                       WidthRequest="38" HeightRequest="38" />
                    <Label Text="Loading garments…" TextColor="{StaticResource Gray900}" FontSize="14" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <views:CustomerDrawer CurrentPage="shop" />
    </Grid>

</ContentPage>
