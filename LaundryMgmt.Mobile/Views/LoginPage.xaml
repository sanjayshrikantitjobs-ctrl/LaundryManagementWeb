<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="LaundryMgmt.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Sign in">

    <Grid RowDefinitions="*,Auto" BackgroundColor="{StaticResource HeaderNavy}">

        <!-- Brand zone -->
        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Spacing="10" Padding="32,10">
            <Border StrokeShape="RoundRectangle 20" Stroke="Transparent" WidthRequest="88" HeightRequest="88"
                    HorizontalOptions="Center" Padding="0" BackgroundColor="Transparent">
                <Image Source="brand_mark.png" Aspect="AspectFit" />
            </Border>
            <Label Text="Shrios Laundry Wala" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource White}" HorizontalTextAlignment="Center" />
            <Label Text="Freshness delivered to your door." FontSize="13.5" TextColor="{StaticResource NavyMuted}"
                   HorizontalTextAlignment="Center" Margin="20,0" />

            <HorizontalStackLayout Spacing="18" HorizontalOptions="Center" Margin="0,10,0,0">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center" WidthRequest="82">
                    <Border Style="{StaticResource IconBadge}" BackgroundColor="{StaticResource HeaderNavyLight}">
                        <shapes:RoundRectangle Fill="{StaticResource Primary}" WidthRequest="16" HeightRequest="18" CornerRadius="4,4,7,7" />
                    </Border>
                    <Label Text="Free Pickup" FontSize="10.5" TextColor="{StaticResource NavyMuted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center" WidthRequest="82">
                    <Border Style="{StaticResource IconBadge}" BackgroundColor="{StaticResource HeaderNavyLight}">
                        <Grid>
                            <shapes:Ellipse Fill="{StaticResource Primary}" WidthRequest="18" HeightRequest="18" />
                            <shapes:Ellipse Fill="{StaticResource HeaderNavyLight}" WidthRequest="8" HeightRequest="8" />
                        </Grid>
                    </Border>
                    <Label Text="Live Tracking" FontSize="10.5" TextColor="{StaticResource NavyMuted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center" WidthRequest="82">
                    <Border Style="{StaticResource IconBadge}" BackgroundColor="{StaticResource HeaderNavyLight}">
                        <shapes:Polygon Points="9,0 18,4 18,10 9,18 0,10 0,4" Fill="{StaticResource Primary}" WidthRequest="16" HeightRequest="16" />
                    </Border>
                    <Label Text="Secure &amp; Safe" FontSize="10.5" TextColor="{StaticResource NavyMuted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Sign-in card -->
        <Border Grid.Row="1" BackgroundColor="{StaticResource Surface}" Stroke="Transparent" Padding="26,30,26,26">
            <Border.StrokeShape>
                <shapes:RoundRectangle CornerRadius="28,28,0,0" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{StaticResource HeaderNavy}" Opacity="0.2" Radius="20" Offset="0,-6" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="14">
                <Label Text="Welcome back" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource HeaderNavy}" />
                <Label Text="Sign in to schedule a pickup or track your order." Style="{StaticResource SubtleLabel}" Margin="0,-8,0,4" />

                <Label Text="USERNAME OR EMAIL" Style="{StaticResource SectionLabel}" Margin="0" />
                <Border StrokeShape="RoundRectangle 10" Stroke="{StaticResource Border}" Padding="0">
                    <Entry Placeholder="you@example.com" Text="{Binding UsernameOrEmail}" Margin="10,0" BackgroundColor="Transparent" />
                </Border>

                <Label Text="PASSWORD" Style="{StaticResource SectionLabel}" Margin="0" />
                <Border StrokeShape="RoundRectangle 10" Stroke="{StaticResource Border}" Padding="0">
                    <Entry Placeholder="••••••••" Text="{Binding Password}" IsPassword="True" Margin="10,0" BackgroundColor="Transparent" />
                </Border>

                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FontSize="13"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

                <Button Text="Sign In" Command="{Binding LoginCommand}" Margin="0,8,0,0" HeightRequest="50"
                        IsEnabled="{Binding IsSubmitting, Converter={StaticResource InvertedBoolConverter}}" />
                <ActivityIndicator IsRunning="{Binding IsSubmitting}" IsVisible="{Binding IsSubmitting}" Color="{StaticResource Primary}" />

                <Label HorizontalTextAlignment="Center" Margin="0,6,0,0">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="New customer? " TextColor="{StaticResource Gray600}" FontSize="14" />
                            <Span Text="Create an account" TextColor="{StaticResource Primary}" FontAttributes="Bold" FontSize="14" />
                        </FormattedString>
                    </Label.FormattedText>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCreateAccountTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
