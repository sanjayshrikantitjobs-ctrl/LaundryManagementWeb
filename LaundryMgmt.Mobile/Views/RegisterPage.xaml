<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             x:Class="LaundryMgmt.Mobile.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Create account">

    <Grid BackgroundColor="{StaticResource PrimaryDark}">
        <ScrollView>
            <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center">
                <Label Text="Create your account" FontSize="22" FontAttributes="Bold"
                       TextColor="{StaticResource White}" HorizontalTextAlignment="Center" Margin="0,0,0,8" />

                <Frame BackgroundColor="{StaticResource White}" Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="FULL NAME" Style="{StaticResource SectionLabel}" />
                        <Entry Text="{Binding FullName}" />

                        <Label Text="PHONE NUMBER (WHATSAPP)" Style="{StaticResource SectionLabel}" />
                        <Entry Text="{Binding PhoneNumber}" Keyboard="Telephone" Placeholder="e.g. 9876543210" />

                        <Label Text="EMAIL" Style="{StaticResource SectionLabel}" />
                        <Entry Text="{Binding Email}" Keyboard="Email" />

                        <Label Text="PASSWORD" Style="{StaticResource SectionLabel}" />
                        <Entry Text="{Binding Password}" IsPassword="True" />

                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />

                        <Button Text="Create account" Command="{Binding RegisterCommand}" Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Already have an account? Sign in" TextColor="{StaticResource White}"
                       HorizontalTextAlignment="Center" Margin="0,8,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignInTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
