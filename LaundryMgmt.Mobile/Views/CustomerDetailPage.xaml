<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             x:Class="LaundryMgmt.Mobile.Views.CustomerDetailPage"
             x:DataType="vm:CustomerDetailViewModel"
             Title="Customer">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                   Padding="12,8" BackgroundColor="{StaticResource DangerLight}" />

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                Color="{StaticResource Primary}" VerticalOptions="Center" />

            <Frame IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Customer.FullName}" FontAttributes="Bold" FontSize="20" />
                    <Label Text="{Binding Customer.Status}" TextColor="{Binding Customer.Status, Converter={StaticResource CustomerStatusColorConverter}}"
                           FontAttributes="Bold" FontSize="13" />

                    <BoxView HeightRequest="1" Color="{StaticResource Gray300}" Margin="0,4" />

                    <Label Text="PHONE" Style="{StaticResource SectionLabel}" />
                    <Label Text="{Binding Customer.PhoneNumber}" />

                    <Label Text="EMAIL" Style="{StaticResource SectionLabel}" />
                    <Label Text="{Binding Customer.Email}" />

                    <Grid ColumnDefinitions="*,*" RowSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="WALLET BALANCE" Style="{StaticResource SectionLabel}" />
                            <Label Text="{Binding Customer.WalletBalance, StringFormat='₹{0:0.00}'}" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="CREDIT LIMIT" Style="{StaticResource SectionLabel}" />
                            <Label Text="{Binding Customer.CreditLimit, StringFormat='₹{0:0.00}'}" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" RowSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="LOYALTY POINTS" Style="{StaticResource SectionLabel}" />
                            <Label Text="{Binding Customer.LoyaltyPoints}" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="MEMBERSHIP TIER" Style="{StaticResource SectionLabel}" />
                            <Label Text="{Binding Customer.MembershipTier}" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="NOTES" Style="{StaticResource SectionLabel}"
                           IsVisible="{Binding Customer.Notes, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="{Binding Customer.Notes}"
                           IsVisible="{Binding Customer.Notes, Converter={StaticResource IsNotNullConverter}}" />
                </VerticalStackLayout>
            </Frame>

            <VerticalStackLayout Spacing="10" IsVisible="{Binding CanEditMasterData}">
                <Button Text="✏️ Edit" Command="{Binding EditCommand}" />
                <Button Text="Deactivate / Activate" Style="{StaticResource OutlineButton}" Command="{Binding ToggleStatusCommand}" />
                <Button Text="🗑️ Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
