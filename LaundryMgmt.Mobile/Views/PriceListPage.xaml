<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             xmlns:models="clr-namespace:LaundryMgmt.Mobile.Models"
             xmlns:views="clr-namespace:LaundryMgmt.Mobile.Views"
             x:Class="LaundryMgmt.Mobile.Views.PriceListPage"
             Shell.TabBarIsVisible="False"
             x:DataType="vm:PriceListViewModel"
             Title="Price List">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <Border Grid.Row="0" StrokeShape="RoundRectangle 10" Stroke="{StaticResource Border}" BackgroundColor="{StaticResource Surface}" Margin="16,10,16,0" Padding="0">
                <Picker Margin="10,0" ItemsSource="{Binding Categories}" ItemDisplayBinding="{Binding CategoryName}"
                        SelectedItem="{Binding SelectedCategory}" Title="Category" />
            </Border>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Channels}" SelectionMode="Single"
                             SelectedItem="{Binding SelectedChannel}" HeightRequest="56">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:OrderChannel">
                        <Border StrokeShape="RoundRectangle 16" Stroke="Transparent" Padding="14,8" Margin="4,8">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter TargetName="ChannelLabel" Property="Label.TextColor" Value="{StaticResource White}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Label x:Name="ChannelLabel" Text="{Binding .}" TextColor="{StaticResource Primary}" FontSize="13" FontAttributes="Bold" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Grid.Row="2" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                   Padding="16,8" BackgroundColor="{StaticResource DangerLight}" />

            <ActivityIndicator Grid.Row="3" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                Color="{StaticResource Primary}" VerticalOptions="Center" />

            <CollectionView Grid.Row="3" ItemsSource="{Binding Rows}" Margin="0,6,0,0"
                             IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                        <Label Text="No pricing available yet." FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Gray600}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PriceListGarmentRow">
                        <Frame Style="{StaticResource ListCard}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding GarmentName}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource HeaderNavy}" />
                                <Label Text="{Binding CategoryName}" Style="{StaticResource SubtleLabel}" />

                                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                    <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Cells}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PriceListCell">
                                                <Border StrokeShape="RoundRectangle 10" Stroke="Transparent" BackgroundColor="{StaticResource Background}" Padding="10,6">
                                                    <VerticalStackLayout Spacing="1">
                                                        <Label Text="{Binding ServiceName}" FontSize="11" Style="{StaticResource SubtleLabel}" />
                                                        <Label Text="{Binding DisplayPrice}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                                        <Label Text="{Binding DisplayEta}" FontSize="10" Style="{StaticResource SubtleLabel}" />
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </ScrollView>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <views:CustomerDrawer CurrentPage="pricelist" />
    </Grid>

</ContentPage>
