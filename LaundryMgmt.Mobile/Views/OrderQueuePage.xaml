<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             x:Class="LaundryMgmt.Mobile.Views.OrderQueuePage"
             x:DataType="vm:OrderQueueViewModel"
             Title="My Queue">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <CollectionView ItemsSource="{Binding AssignedOrders}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" VerticalOptions="Center">
                    <Label Text="No pickups or deliveries assigned right now." HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:AssignedOrderSummary">
                    <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding OrderNumber}" FontAttributes="Bold" />
                            <Label Text="{Binding CustomerName}" FontSize="14" />
                            <Label Text="{Binding Address}" FontSize="12" TextColor="{StaticResource Gray300}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Status}" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>

</ContentPage>
