<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             xmlns:models="clr-namespace:LaundryMgmt.Mobile.Models"
             xmlns:views="clr-namespace:LaundryMgmt.Mobile.Views"
             xmlns:behaviors="clr-namespace:LaundryMgmt.Mobile.Behaviors"
             x:Class="LaundryMgmt.Mobile.Views.ServicesPage"
             x:DataType="vm:ServicesViewModel"
             Title="Services">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <views:ModuleBreadcrumb Grid.Row="0" CurrentModule="services" />

        <Button Grid.Row="1" Text="+ New Service" HorizontalOptions="End" Margin="16,8"
                Command="{Binding NewServiceCommand}" IsVisible="{Binding CanEditMasterData}" />

        <Label Grid.Row="2" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
               Padding="16,8" BackgroundColor="{StaticResource DangerLight}" />

        <RefreshView Grid.Row="3" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Services}"
                            RemainingItemsThreshold="3"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                        <Label Text="🧼" FontSize="40" HorizontalTextAlignment="Center" />
                        <Label Text="No services found." HorizontalTextAlignment="Center" Style="{StaticResource SubtleLabel}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ServiceListItem">
                        <Frame Style="{StaticResource ListCard}" Padding="12,10" MinimumHeightRequest="72">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    CommandParameter="{Binding .}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenServiceCommand}" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                        BackgroundColor="{StaticResource PrimaryLight}" WidthRequest="44" HeightRequest="44" Padding="0"
                                        VerticalOptions="Center" Margin="0,0,12,0">
                                    <Grid>
                                        <Label Text="{Binding Name, Converter={StaticResource ServiceIconConverter}}"
                                               FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                                        <Image behaviors:TrustedImage.Url="{Binding ImageUrl, Converter={StaticResource ResolvedImageUrlConverter}}"
                                               Aspect="AspectFill" IsVisible="{Binding ImageUrl, Converter={StaticResource IsNotNullConverter}}" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                    <Label Text="{Binding BasePrice, StringFormat='₹{0:0.00}'}" Style="{StaticResource SubtleLabel}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
