<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             xmlns:models="clr-namespace:LaundryMgmt.Mobile.Models"
             xmlns:behaviors="clr-namespace:LaundryMgmt.Mobile.Behaviors"
             x:Class="LaundryMgmt.Mobile.Views.GarmentDetailPage"
             x:DataType="vm:GarmentDetailViewModel"
             Title="Garment">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                   Padding="12,8" BackgroundColor="{StaticResource DangerLight}" />

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                Color="{StaticResource Primary}" VerticalOptions="Center" />

            <Frame IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="10">
                    <Border StrokeShape="RoundRectangle 12" Stroke="Transparent" BackgroundColor="{StaticResource Gray50}"
                            HeightRequest="160" Padding="0"
                            IsVisible="{Binding Garment.ImageUrl, Converter={StaticResource IsNotNullConverter}}">
                        <Image behaviors:TrustedImage.Url="{Binding Garment.ImageUrl, Converter={StaticResource ResolvedImageUrlConverter}}"
                               Aspect="AspectFill" />
                    </Border>

                    <Label Text="{Binding Garment.Name}" FontAttributes="Bold" FontSize="20" />
                    <Label Text="{Binding Garment.CategoryName}" Style="{StaticResource SubtleLabel}" />

                    <Label Text="SPECIAL INSTRUCTIONS" Style="{StaticResource SectionLabel}"
                           IsVisible="{Binding Garment.SpecialInstructions, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="{Binding Garment.SpecialInstructions}"
                           IsVisible="{Binding Garment.SpecialInstructions, Converter={StaticResource IsNotNullConverter}}" />

                    <Label Text="PRICED SERVICES" Style="{StaticResource SectionLabel}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Garment.ServicePrices}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:GarmentServicePriceDto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding ServiceName}" />
                                    <Label Grid.Column="1" Text="{Binding Price, StringFormat='₹{0:0.00}'}" FontAttributes="Bold" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <VerticalStackLayout Spacing="10" IsVisible="{Binding CanEditMasterData}">
                <Button Text="✏️ Edit" Command="{Binding EditCommand}" />
                <Button Text="🗑️ Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
