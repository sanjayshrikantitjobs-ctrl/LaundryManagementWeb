<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             x:Class="LaundryMgmt.Mobile.Views.UserDetailPage"
             x:DataType="vm:UserDetailViewModel"
             Title="User">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
                   Padding="12,8" BackgroundColor="{StaticResource DangerLight}" />

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                Color="{StaticResource Primary}" VerticalOptions="Center" />

            <Frame IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding User.FullName}" FontAttributes="Bold" FontSize="20" />
                    <Label Text="{Binding User.Role}" Style="{StaticResource Badge}" />
                    <Label Text="Inactive" TextColor="{StaticResource Danger}" FontAttributes="Bold" FontSize="12"
                           IsVisible="{Binding User.IsActive, Converter={StaticResource InvertedBoolConverter}}" />

                    <BoxView HeightRequest="1" Color="{StaticResource Gray300}" Margin="0,4" />

                    <Label Text="USERNAME" Style="{StaticResource SectionLabel}" />
                    <Label Text="{Binding User.UserName}" />

                    <Label Text="EMAIL" Style="{StaticResource SectionLabel}"
                           IsVisible="{Binding User.Email, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="{Binding User.Email}"
                           IsVisible="{Binding User.Email, Converter={StaticResource IsNotNullConverter}}" />

                    <Label Text="PHONE" Style="{StaticResource SectionLabel}"
                           IsVisible="{Binding User.PhoneNumber, Converter={StaticResource IsNotNullConverter}}" />
                    <Label Text="{Binding User.PhoneNumber}"
                           IsVisible="{Binding User.PhoneNumber, Converter={StaticResource IsNotNullConverter}}" />
                </VerticalStackLayout>
            </Frame>

            <VerticalStackLayout Spacing="10">
                <Button Text="✏️ Edit" Command="{Binding EditCommand}" />
                <Button Text="Deactivate / Activate" Style="{StaticResource OutlineButton}" Command="{Binding ToggleActiveCommand}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
