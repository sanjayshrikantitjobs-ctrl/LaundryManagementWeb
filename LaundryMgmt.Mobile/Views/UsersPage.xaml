<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LaundryMgmt.Mobile.ViewModels"
             xmlns:models="clr-namespace:LaundryMgmt.Mobile.Models"
             xmlns:views="clr-namespace:LaundryMgmt.Mobile.Views"
             x:Class="LaundryMgmt.Mobile.Views.UsersPage"
             Shell.TabBarIsVisible="False"
             x:DataType="vm:UsersViewModel"
             Title="Users">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <views:ModuleBreadcrumb Grid.Row="0" CurrentModule="users" />

        <SearchBar Grid.Row="1"
                   Placeholder="Search by name, username or email…"
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding RefreshCommand}" />

        <Button Grid.Row="2" Text="+ New User" HorizontalOptions="End" Margin="16,0,16,8"
                Command="{Binding NewUserCommand}" />

        <Label Grid.Row="3" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}"
               Padding="16,8" BackgroundColor="{StaticResource DangerLight}" />

        <RefreshView Grid.Row="4" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Users}"
                            RemainingItemsThreshold="3"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                        <Label Text="🧑‍💼" FontSize="40" HorizontalTextAlignment="Center" />
                        <Label Text="No users found." HorizontalTextAlignment="Center" Style="{StaticResource SubtleLabel}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:UserSummaryDto">
                        <Frame Style="{StaticResource ListCard}" Padding="16,14" MinimumHeightRequest="76">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    CommandParameter="{Binding .}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenUserCommand}" />
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding FullName}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                <Label Text="{Binding UserName}" Style="{StaticResource SubtleLabel}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding Role}" Style="{StaticResource Badge}" />
                                <Label Text="Inactive" TextColor="{StaticResource Danger}" FontAttributes="Bold" FontSize="12"
                                       IsVisible="{Binding IsActive, Converter={StaticResource InvertedBoolConverter}}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
