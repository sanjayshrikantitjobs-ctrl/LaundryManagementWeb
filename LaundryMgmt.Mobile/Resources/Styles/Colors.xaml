<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Matches client-web's palette (src/styles.scss) so the mobile app and the web
         portal read as one product: fresh green brand, sky-blue accent. -->
    <Color x:Key="Primary">#1A9F5C</Color>
    <Color x:Key="PrimaryDark">#0F7A45</Color>
    <Color x:Key="PrimaryLight">#E6F7ED</Color>
    <Color x:Key="Accent">#0AA1DC</Color>
    <Color x:Key="AccentLight">#E3F6FD</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Gray50">#F6F8F7</Color>
    <Color x:Key="Gray600">#5B6670</Color>
    <Color x:Key="Gray900">#2B2F33</Color>
    <Color x:Key="Gray300">#E3E8EB</Color>
    <Color x:Key="Success">#15803D</Color>
    <Color x:Key="Danger">#DC2626</Color>
    <Color x:Key="DangerLight">#FEE2E2</Color>

    <!-- Shrios Laundry Wala identity: a deep navy app bar/drawer (trust, premium feel)
         paired with the fresh green for primary actions — navy is chrome, green is "do this". -->
    <Color x:Key="HeaderNavy">#101B33</Color>
    <Color x:Key="HeaderNavyDark">#0A1226</Color>
    <Color x:Key="HeaderNavyLight">#22304F</Color>
    <!-- Brand blue lifted from the logo's cloud — used for the header gradient so the
         app bar reads richer than flat navy and gives white icons real contrast. -->
    <Color x:Key="HeaderBlue">#0E4E85</Color>
    <Color x:Key="NavyMuted">#8E9AB8</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Background">#F4F6F9</Color>
    <Color x:Key="Border">#E7EAF0</Color>
    <Color x:Key="Overlay">#66101B33</Color>
</ResourceDictionary>
