<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>LaundryMgmt.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Laundry Staff</ApplicationTitle>
    <ApplicationId>com.laundrymgmt.staff</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon (commented out while images are missing) -->
    <!-- <MauiIcon Include="Resources\Images\appicon.svg" ForegroundFile="Resources\Images\appiconfg.svg" Color="#3730A3" /> -->
    <!-- Splash Screen (remove or point to existing file if you don't have a splash.svg) -->
    <!-- <MauiSplashScreen Include="Resources\Images\splash.svg" Color="#3730A3" BaseSize="128,128" /> -->
    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <PropertyGroup>
    <!-- If you are not producing an MSIX package on Windows, disable MSIX requirement -->
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <PackageReference Include="ZXing.Net.MAUI" Version="0.4.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!-- Workaround: avoid duplicate AndroidX tracing classes coming from different AARs
       by excluding runtime assets for one of the tracing packages if present in the
       transitive dependency graph. This prevents inclusion of duplicate .class files
       (e.g., TraceKt$traceAsync$1) that cause R8 compile errors. If the exact
       package id differs in your transitive graph, update/remove these entries. -->
  <ItemGroup>
    <PackageReference Update="Xamarin.AndroidX.Tracing.Tracing" ExcludeAssets="runtime" />
    <PackageReference Update="Xamarin.AndroidX.Tracing.Tracing.Ktx" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\LaundryMgmt.Shared\LaundryMgmt.Shared.csproj" />
  </ItemGroup>

</Project>
